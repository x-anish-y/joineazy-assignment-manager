# ============================================================
# JoinEazy Assignment Manager - Environment Configuration
# ============================================================

# ── Database (Local Docker PostgreSQL) ────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=joineazy
DB_PORT=5432

# ── Backend Database Connection ──────────────────────────────
# For local Docker: postgresql://postgres:postgres@db:5432/joineazy
# For Neon / Hosted DB: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@db:5432/joineazy

# Set to true when connecting to hosted PostgreSQL with SSL (e.g., Neon)
DB_SSL=false

# ── JWT Authentication ───────────────────────────────────────
# Secret key used for signing and verifying JSON Web Tokens (7d expiry)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ── Backend Server Settings ──────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS Settings ────────────────────────────────────────────
# Allowed origin(s) for frontend requests (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────
# Time window in milliseconds (default: 15 minutes = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000
# Maximum total requests per window
RATE_LIMIT_MAX_REQUESTS=1000
# Maximum auth attempts (/api/auth/*) per window
AUTH_RATE_LIMIT_MAX=100

# ── Frontend Build Configuration ─────────────────────────────
# Base API URL embedded into Vite during build
# For local Docker: http://localhost:5000
# For production (Vercel): https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000
